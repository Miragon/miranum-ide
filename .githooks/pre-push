#!/bin/sh
set -e

echo "▶ Pre-push: yarn install --immutable"
corepack yarn install --immutable

echo "▶ Pre-push: yarn constraints"
corepack yarn constraints

echo "▶ Pre-push: lint"
corepack yarn lint

echo "▶ Pre-push: knip"
corepack yarn knip

echo "▶ Pre-push: Vitest CI targets"
node .github/scripts/check-vitest-targets.mjs

# Tests and builds are intentionally NOT run here: the Build CI workflow
# (.github/workflows/build.yml) runs every affected Vitest target from
# .github/vitest-targets.json with its coverage gate, the typechecks and the
# app/package builds on every PR. Pre-push stays the cheap, fast-feedback gate.
echo "✓ Pre-push checks passed (tests + builds run in CI)."
